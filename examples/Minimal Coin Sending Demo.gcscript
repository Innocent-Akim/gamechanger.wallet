{
  "type": "script",
  "title": "Minimal Coin Sending Demo",
  "description": "Instead of using key-value maps for list of block code, here we use arrays and number indexes, making code less self explanatory but much smaller. The 'outputs' property of the 'buildTx' API function allows you to define multi-asset transaction outputs. In Cardano assets are defined by a policyId and an assetName, for ADA we use 'ada' in both cases. Receiver, asset and quantity are exposed as flat arguments so an auto-generated dapp can drive them, and they are checked with assert() before the wallet builds anything. A GameChanger Wallet Dapp Demo. https://gamechanger.finance/",
  "exportAs": "MinimalCoinSending",
  "return": {
    "mode": "last"
  },
  "args": {
    "to-address": "addr1q9faamq9k6557gve35amtdqph99h9q2txhz07chaxg6uwwgd6j6v0fc04n5ehg292yxvs292vesrqqmxqfnp7yuwn7yqczuqwr",
    "policy-id": "ada",
    "asset-name": "ada",
    "quantity": "1000000"
  },
  "run": [
    {
      "type": "macro",
      "run": {
        "to-address-must-not-be-empty": "{ assert( not(isEmptyString(get('args.to-address'))) ,'to-address must not be empty' , get('args') ) }",
        "policy-id-must-not-be-empty": "{ assert( not(isEmptyString(get('args.policy-id'))) ,'policy-id must not be empty, use ada for lovelaces' , get('args') ) }",
        "quantity-must-be-positive": "{ assert( cmpBigNum('gt',get('args.quantity'),'0') ,'quantity must be greater than zero' , get('args') ) }"
      }
    },
    {
      "type": "buildTx",
      "tx": {
        "outputs": [
          {
            "address": "{get('args.to-address')}",
            "assets": [
              {
                "policyId": "{get('args.policy-id')}",
                "assetName": "{get('args.asset-name')}",
                "quantity": "{get('args.quantity')}"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "signTxs",
      "detailedPermissions": false,
      "txs": [
        "{get('cache.1.txHex')}"
      ]
    },
    {
      "type": "submitTxs",
      "txs": "{get('cache.2')}"
    }
  ]
}
