{
  "title": "Boolean Predicate Functions",
  "description": "This demo will test and explore logical operators, equality predicates, type predicates and empty string checks",
  "type": "script",
  "exportAs": "BooleanPredicatesDemo",
  "run": {
    "useCases": {
      "type": "macro",
      "run": {
        "and(true,true)": "{and(true,true)}",
        "and(true,false)": "{and(true,false)}",
        "and(true,true,true)": "{and(true,true,true)}",
        "and(true,true,false)": "{and(true,true,false)}",
        "or(true,true)": "{or(true,true)}",
        "or(true,false)": "{or(true,false)}",
        "or(false,false)": "{or(false,false)}",
        "or(false,false,true)": "{or(false,false,true)}",
        "not(true)": "{not(true)}",
        "not(false)": "{not(false)}",
        "eq(0,0)": "{eq(0,0)}",
        "eq(0,'0')": "{eq(0,'0')}",
        "eq('', '')": "{eq('', '')}",
        "eq(null,null)": "{eq(null,null)}",
        "eq(true,true)": "{eq(true,true)}",
        "eq(true,false)": "{eq(true,false)}",
        "eq(jsonToObj('[]'),jsonToObj('[]'))": "{eq(jsonToObj('[]'),jsonToObj('[]'))}",
        "eq(jsonToObj('[1,2]'),jsonToObj('[1,2]'))": "{eq(jsonToObj('[1,2]'),jsonToObj('[1,2]'))}",
        "eq(jsonToObj('[1,2]'),jsonToObj('[2,1]'))": "{eq(jsonToObj('[1,2]'),jsonToObj('[2,1]'))}",
        "eq(jsonToObj('{}'),jsonToObj('{}'))": "{eq(jsonToObj('{}'),jsonToObj('{}'))}",
        "eq(jsonToObj('{\"a\":1,\"b\":2}'),jsonToObj('{\"b\":2,\"a\":1}'))": "{eq(jsonToObj('{\"a\":1,\"b\":2}'),jsonToObj('{\"b\":2,\"a\":1}'))}",
        "eq(jsonToObj('{\"a\":[1,2]}'),jsonToObj('{\"a\":[1,2]}'))": "{eq(jsonToObj('{\"a\":[1,2]}'),jsonToObj('{\"a\":[1,2]}'))}",
        "eq(jsonToObj('{\"a\":[1,2]}'),jsonToObj('{\"a\":[2,1]}'))": "{eq(jsonToObj('{\"a\":[1,2]}'),jsonToObj('{\"a\":[2,1]}'))}",
        "neq(0,0)": "{neq(0,0)}",
        "neq(0,'0')": "{neq(0,'0')}",
        "neq('', '')": "{neq('', '')}",
        "neq(null,null)": "{neq(null,null)}",
        "neq(true,true)": "{neq(true,true)}",
        "neq(true,false)": "{neq(true,false)}",
        "neq(jsonToObj('[]'),jsonToObj('[]'))": "{neq(jsonToObj('[]'),jsonToObj('[]'))}",
        "neq(jsonToObj('[1,2]'),jsonToObj('[1,2]'))": "{neq(jsonToObj('[1,2]'),jsonToObj('[1,2]'))}",
        "neq(jsonToObj('[1,2]'),jsonToObj('[2,1]'))": "{neq(jsonToObj('[1,2]'),jsonToObj('[2,1]'))}",
        "neq(jsonToObj('{}'),jsonToObj('{}'))": "{neq(jsonToObj('{}'),jsonToObj('{}'))}",
        "neq(jsonToObj('{\"a\":1,\"b\":2}'),jsonToObj('{\"b\":2,\"a\":1}'))": "{neq(jsonToObj('{\"a\":1,\"b\":2}'),jsonToObj('{\"b\":2,\"a\":1}'))}",
        "neq(jsonToObj('{\"a\":[1,2]}'),jsonToObj('{\"a\":[1,2]}'))": "{neq(jsonToObj('{\"a\":[1,2]}'),jsonToObj('{\"a\":[1,2]}'))}",
        "neq(jsonToObj('{\"a\":[1,2]}'),jsonToObj('{\"a\":[2,1]}'))": "{neq(jsonToObj('{\"a\":[1,2]}'),jsonToObj('{\"a\":[2,1]}'))}",
        "isType('string','hello')": "{isType('string','hello')}",
        "isType('string','')": "{isType('string','')}",
        "isType('string',123)": "{isType('string',123)}",
        "isType('null',null)": "{isType('null',null)}",
        "isType('null',undefined)": "{isType('null',undefined)}",
        "isType('null','')": "{isType('null','')}",
        "isType('number',0)": "{isType('number',0)}",
        "isType('number',123)": "{isType('number',123)}",
        "isType('number','123')": "{isType('number','123')}",
        "isType('boolean',true)": "{isType('boolean',true)}",
        "isType('boolean',false)": "{isType('boolean',false)}",
        "isType('boolean',0)": "{isType('boolean',0)}",
        "isType('boolean','true')": "{isType('boolean','true')}",
        "isType('undefined',undefined)": "{isType('undefined',undefined)}",
        "isType('undefined',null)": "{isType('undefined',null)}",
        "isType('undefined','')": "{isType('undefined','')}",
        "isType('array',jsonToObj('[]'))": "{isType('array',jsonToObj('[]'))}",
        "isType('array',jsonToObj('[1,2,3]'))": "{isType('array',jsonToObj('[1,2,3]'))}",
        "isType('array',jsonToObj('{}'))": "{isType('array',jsonToObj('{}'))}",
        "isType('object',jsonToObj('{}'))": "{isType('object',jsonToObj('{}'))}",
        "isType('object',jsonToObj('[]'))": "{isType('object',jsonToObj('[]'))}",
        "isType('object',null)": "{isType('object',null)}",
        "isEmptyString('')": "{isEmptyString('')}",
        "isEmptyString('hello')": "{isEmptyString('hello')}",
        "isEmptyString(0)": "{isEmptyString(0)}",
        "isEmptyString(null)": "{isEmptyString(null)}",
        "and(isType('string','hello'),isType('number',123))": "{and(isType('string','hello'),isType('number',123))}",
        "and(isType('string','hello'),isType('number','123'))": "{and(isType('string','hello'),isType('number','123'))}",
        "or(isType('null',null),isType('undefined',null))": "{or(isType('null',null),isType('undefined',null))}",
        "not(isEmptyString('hello'))": "{not(isEmptyString('hello'))}",
        "eq(isType('number',123),true)": "{eq(isType('number',123),true)}",
        "neq(isType('string',123),true)": "{neq(isType('string',123),true)}",
        "eq(jsonToObj('[]'),jsonToObj('{}'))": "{eq(jsonToObj('[]'),jsonToObj('{}'))}",
        "neq(jsonToObj('[]'),jsonToObj('{}'))": "{neq(jsonToObj('[]'),jsonToObj('{}'))}",
        "eq(jsonToObj('{\"a\":{\"b\":1}}'),jsonToObj('{\"a\":{\"b\":1}}'))": "{eq(jsonToObj('{\"a\":{\"b\":1}}'),jsonToObj('{\"a\":{\"b\":1}}'))}",
        "cmpBigNum('eq','10','10')": "{cmpBigNum('eq','10','10')}",
        "cmpBigNum('eq','10','11')": "{cmpBigNum('eq','10','11')}",
        "cmpBigNum('ne','10','11')": "{cmpBigNum('ne','10','11')}",
        "cmpBigNum('ne','10','10')": "{cmpBigNum('ne','10','10')}",
        "cmpBigNum('gt','11','10')": "{cmpBigNum('gt','11','10')}",
        "cmpBigNum('gt','10','10')": "{cmpBigNum('gt','10','10')}",
        "cmpBigNum('gte','10','10')": "{cmpBigNum('gte','10','10')}",
        "cmpBigNum('gte','11','10')": "{cmpBigNum('gte','11','10')}",
        "cmpBigNum('gte','9','10')": "{cmpBigNum('gte','9','10')}",
        "cmpBigNum('lt','9','10')": "{cmpBigNum('lt','9','10')}",
        "cmpBigNum('lt','10','10')": "{cmpBigNum('lt','10','10')}",
        "cmpBigNum('lte','10','10')": "{cmpBigNum('lte','10','10')}",
        "cmpBigNum('lte','9','10')": "{cmpBigNum('lte','9','10')}",
        "cmpBigNum('lte','11','10')": "{cmpBigNum('lte','11','10')}",
        "cmpBigNum('eq',10,'10')": "{cmpBigNum('eq',10,'10')}",
        "cmpBigNum('gt','18446744073709551615','0')": "{cmpBigNum('gt','18446744073709551615','0')}",
        "cmpBigNum('eq','18446744073709551615','18446744073709551615')": "{cmpBigNum('eq','18446744073709551615','18446744073709551615')}"
      }
    }
  }
}